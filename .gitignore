.vs/
.idea/
.serena/
.DS_Store
*.vcxproj.user
.qmake.stash
*.cbt
x64/
x86/
/apps/desktop/backup
/apps/desktop/debug/moc_predefs.h.cbt
/Back
.deps/
build_*.txt
build_*.json
*.log
*.obj
dist/
.codex-build-logs/
.codex-tmp/
package_stage/
tmp-qmake-mm*/
windeployqt_raw.txt
vs_install.json
aqtinstall.log
# Local signing private key materials are allowed only on the development machine to prevent accidental upload to GitHub.
*.pfx
*.p12
*.pvk
*.key
*.snk
*.pem
.cert/*
!.cert/
!.cert/KswordARK-TestSigning.cer

# Local path configuration generated by the local Qt/MSBuild auto-detection script.
Directory.Build.local.props

# apps/setup build-generated embedded payload resource lists.
/apps/setup/generated/

# apps/ark_light copies KswordARK.sys here right before ResourceCompile so the
# executable can embed the driver without committing build binaries.
/apps/ark_light/generated/

# Runtime/generated profile assets stay local and are republished into release packages.
/apps/desktop/profiles/

# Scratch task notes/screenshots and Python bytecode caches are local-only.
/artifacts/bin/Task/
/_codex_backups/
__pycache__/
*.py[cod]
.venv/

# Plugin payloads (models, interpreter dependencies, and third-party code) are published independently to KSwordDEV/Plugins.
# Not delivered with the Ksword source repository or release packages; installed on demand by the plugin marketplace at runtime.
/plugin/

# Local-only VoIP debugging utility; never publish its source or build output.
/tools/voip_status_debugger/

# HVM acceptance tool build artifacts. Source code is committed, binaries are not: they are built by
# scripts/Build-KswordHvmTools.ps1 is compiled on-the-fly and must be deployed to the test machine every time.
# Submitting this will cause a meaningless binary diff in every acceptance round.
/tools/hvm_ctl/*.exe
/tools/hvm_probe/*.exe
/tools/hvm_target/*.exe
/tools/attest_probe/*.exe
# hvm_probe_dll is a DLL, not an EXE, so it doesn't fit the patterns above and requires a separate line.
# It was previously committed along with `git add tools/` for this reason.
/tools/hvm_probe_dll/*.dll

# MSVC compiler PDB left in the repository root.
/vc140.pdb

# Output location for CI and local audit/unit test runs (ci.yml uses artifacts/ as the upload directory).
# The report is generated fresh each time; committing it would only cause a meaningless diff in every CI run.
/artifacts/

# Full kernel memory dumps. The repository tracks small minidumps (under 1 MB)
# as evidence; a complete memory image is a different thing at ~500 MB, cannot be
# removed from history once committed, and exceeds what hosting will accept.
# Keep them next to the other logs on disk, out of version control.
docs/next/logs/*full*.dmp
