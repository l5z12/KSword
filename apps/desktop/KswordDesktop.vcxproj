  </Target>
  <!-- Qt's official dynamic libraries are built with MSVC /MD. Even if Ksword5.1.exe itself uses /MT, the VC runtime DLLs must still be deployed alongside the Release output. -->
  <Target Name="CopyVisualCppRuntimeRedist" AfterTargets="Build" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ItemGroup>
      <KswordVisualCppRuntimeRedist Include="$(VCToolsRedistDir)x64\Microsoft.VC143.CRT\*.dll" Condition="'$(VCToolsRedistDir)' != ''" />
      <KswordVisualCppRuntimeRedist Include="$(VCInstallDir)Redist\MSVC\*\x64\Microsoft.VC143.CRT\*.dll" Condition="'$(VCInstallDir)' != ''" />
